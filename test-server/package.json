{
  "name": "cql-test-server",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "build": "npm --prefix .. run build && tsc && npm run copyfiles",
    "copyfiles": "copyfiles -u 1 src/translate/**/*.{xml,cql} dist",
    "start": "node dist/app.js",
    "dev": "npm --prefix .. run build && tsx watch --include \"src/**/*.ts\" src/app.ts",
    "check": "npm run test && npm run lint && npm run prettier",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prettier": "prettier --check \"**/*.{js,mjs,ts}\"",
    "prettier:fix": "prettier --write \"**/*.{js,mjs,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest -w"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@cqframework/cql": "^4.0.0-beta.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "tslog": "^4.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fhir": "^0.0.44",
    "@types/node": "^25.9.5",
    "copyfiles": "^2.4.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
