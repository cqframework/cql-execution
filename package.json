  "devDependencies": {
    "@types/luxon": "^3.7.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/should-sinon": "^0.0.13",
    "@types/sinon": "^22.0.0",
    "@types/test-console": "^2.0.3",
    "cross-env": "^10.1.0",
    "mocha": "^12.0.0-rc.6",
    "nyc": "^18.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "should": "^13.2.3",
    "should-sinon": "0.0.6",
    "sinon": "^22.1.0",
    "test-console": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "xml-js": "^1.6.11"
  },
  "dependencies": {
    "@lhncbc/ucum-lhc": "^7.1.9",
    "immutable": "^5.1.6",
    "luxon": "^3.7.2"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "^7.0.3"
    }
  },
  "main": "lib/cql",
  "types": "lib/cql.d.ts",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "build:test-data": "cd \"./test/generator\" && \"./gradlew\" generateTestData && cd ..",
    "build:spec-test-data": "node \"test/spec-tests/generate-cql.js\" && cd \"./test/generator\" && \"./gradlew\" generateSpecTestData && cd ../.. && node \"test/spec-tests/prettify-json.js\"",
    "build:all": "npm run build && npm run build:test-data && npm run build:spec-test-data",
    "watch:test-data": "cd \"./test/generator\" && \"./gradlew\" watchTestData && cd ..",
    "check-skip-list": "node \"test/spec-tests/check-skip-list.js\"",
    "test": "cross-env TSX_TSCONFIG_PATH=\"./test/tsconfig.json\" mocha --reporter spec --recursive",
    "test:nyc": "cross-env TSX_TSCONFIG_PATH=\"./test/tsconfig.json\" nyc --reporter=html npx mocha --reporter spec --recursive",
    "test:watch": "cross-env TSX_TSCONFIG_PATH=\"./test/tsconfig.json\" mocha --reporter spec --recursive --watch",
    "test:typecheck": "tsc --project test/tsconfig.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prettier": "prettier --check \"**/*.{js,mjs,ts}\"",
    "prettier:fix": "prettier --write \"**/*.{js,mjs,ts}\"",
    "check": "npm run build:all && npm run test:typecheck && npm test && npm run lint && npm run prettier",
    "check:all": "npm run check && npm --prefix test-server install && npm --prefix test-server run check && npm --prefix examples/browser install && npm --prefix examples/browser test && npm --prefix examples/node install && npm --prefix examples/node test && npm --prefix examples/typescript install && npm --prefix examples/typescript test && echo \"\nAll checks passed.\"",
    "test:plus": "echo 'Please use `npm check` instead.'"
  },
  "license": "Apache-2.0"
}
